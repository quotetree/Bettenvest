# Cloud database. Leave these blank to store data in .data on this computer.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. The migration seeds this workspace when you run it.
WORKSPACE_ID=00000000-0000-4000-8000-000000000001

# Used for MLS extraction, comp extraction, and the two underwriting prompts.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Used when a newsletter is sent. Without a key, sends are saved and no email is delivered.
RESEND_API_KEY=
EMAIL_FROM="Bettenvest <onboarding@resend.dev>"

# Public origin used in email links. Cron calls /api/cron/send-campaigns with Bearer CRON_SECRET.
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=
